<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>12.0</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="src\Convergence.Framework\Convergence.Framework.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="Data\Jsons\**" />
    <Content Include="Data\Jsons\*.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Convergence.Tests\**\*.cs" />
    <Compile Remove="samples\**\*.cs" />
    <Compile Remove="src\**\*.cs" />
    <Compile Remove="tests\**\*.cs" />
    <None Remove="Convergence.Tests\**" />
    <None Remove="samples\**" />
    <None Remove="src\**" />
    <None Remove="tests\**" />
  </ItemGroup>

</Project>
