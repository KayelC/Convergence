+    "ailments": { "type": "array", "items": { "$ref": "#/$defs/ailment" } }
+  },
+  "$defs": {
+    "turnBehavior": {
+      "oneOf": [
+        {
+          "type": "object", "additionalProperties": false,
+          "required": ["type"],
+          "properties": { "type": { "enum": ["normal", "skip", "forced_basic_attack", "confused_action"] } }
+        },
+        {
+          "type": "object", "additionalProperties": false,
+          "required": ["type", "allowedActionIds"],
+          "properties": {
+            "type": { "const": "limited_actions" },
+            "allowedActionIds": { "type": "array", "minItems": 1, "items": { "$ref": "urn:convergence:schema:content:v9:shared#/$defs/contentId" } }
+          }
+        },
+        {
+          "type": "object", "additionalProperties": false,
+          "required": ["type", "skipChance"],
+          "properties": {
+            "type": { "const": "chance_skip" },
+            "skipChance": { "type": "integer", "minimum": 0, "maximum": 100 }
+          }
+        },
+        {
+          "type": "object", "additionalProperties": false,
+          "required": ["type", "skipChance", "fleeChance", "companionFleeOutcome"],
+          "properties": {
+            "type": { "const": "chance_skip_or_flee" },
+            "skipChance": { "type": "integer", "minimum": 0, "maximum": 100 },
+            "fleeChance": { "type": "integer", "minimum": 0, "maximum": 100 },
+            "companionFleeOutcome": { "enum": ["recall_to_roster", "escape_battle"] }
+          }
+        },
+        {
+          "type": "object", "additionalProperties": false,
+          "required": ["type", "handlerId"],
+          "properties": {
+            "type": { "const": "custom" },
+            "handlerId": { "$ref": "urn:convergence:schema:content:v9:shared#/$defs/contentId" },
+            "parameters": { "$ref": "urn:convergence:schema:content:v9:shared#/$defs/parameters" }
+          }
+        }
+      ]
+    },
+    "ailment": {
+      "type": "object", "additionalProperties": false,
+      "required": ["id", "displayName", "description", "defaultLifetime", "turnBehavior", "modifiers", "recovery"],
+      "properties": {
+        "id": { "$ref": "urn:convergence:schema:content:v9:shared#/$defs/localId" },
+        "displayName": { "$ref": "urn:convergence:schema:content:v9:shared#/$defs/nonEmptyString" },
+        "description": { "type": "string" },
+        "groupIds": { "type": "array", "items": { "$ref": "urn:convergence:schema:content:v9:shared#/$defs/contentId" } },
+        "exclusivityGroupId": { "$ref": "urn:convergence:schema:content:v9:shared#/$defs/contentId" },
+        "defaultLifetime": { "$ref": "urn:convergence:schema:content:v9:shared#/$defs/statusLifetime" },
+        "turnBehavior": { "$ref": "#/$defs/turnBehavior" },
+        "modifiers": {
+          "type": "object", "additionalProperties": false,
+          "required": ["evasionMultiplier", "criticalChanceTakenBonus", "damageTakenMultiplier", "damageDealtMultiplier", "isRigidBody"],
+          "properties": {
+            "evasionMultiplier": { "type": "number" },
+            "criticalChanceTakenBonus": { "type": "integer" },
+            "damageTakenMultiplier": { "type": "number" },
+            "damageDealtMultiplier": { "type": "number" },
+            "isRigidBody": { "type": "boolean" }
+          }
+        },
+        "triggers": { "type": "array", "items": { "$ref": "urn:convergence:schema:content:v9:shared#/$defs/passiveTrigger" } },
+        "recovery": {
+          "type": "object", "additionalProperties": false,
