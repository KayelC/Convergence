+    "item": {
+      "type": "object", "additionalProperties": false,
+      "required": ["id", "displayName", "description", "itemKind", "stackLimit", "baseValue"],
+      "properties": {
+        "id": { "$ref": "urn:convergence:schema:content:v9:shared#/$defs/localId" },
+        "displayName": { "$ref": "urn:convergence:schema:content:v9:shared#/$defs/nonEmptyString" },
+        "description": { "type": "string" },
+        "itemKind": { "enum": ["consumable", "key", "material", "valuable"] },
