+          "type": "object",
+          "propertyNames": { "enum": ["light", "dark"] },
+          "additionalProperties": { "$ref": "urn:convergence:schema:content:v9:shared#/$defs/resistanceLevel" }
+        },
+        "baseSkillIds": { "type": "array", "items": { "$ref": "urn:convergence:schema:content:v9:shared#/$defs/contentId" } },
