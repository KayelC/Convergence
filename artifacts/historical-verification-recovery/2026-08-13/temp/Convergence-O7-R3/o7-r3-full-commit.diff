+    "recipe": {
+      "type": "object",
+      "additionalProperties": false,
+      "required": ["id", "displayName", "description", "parents", "result"],
+      "properties": {
+        "id": { "$ref": "urn:convergence:schema:content:v9:shared#/$defs/localId" },
+        "displayName": { "$ref": "urn:convergence:schema:content:v9:shared#/$defs/nonEmptyString" },
+        "description": { "type": "string" },
+        "parents": {
+          "type": "array",
+          "minItems": 2,
+          "maxItems": 2,
+          "items": { "$ref": "#/$defs/parent" }
+        },
+        "result": { "$ref": "#/$defs/result" },
+        "accidentPolicyId": { "$ref": "urn:convergence:schema:content:v9:shared#/$defs/localId" },
+        "mutationPolicyId": { "$ref": "urn:convergence:schema:content:v9:shared#/$defs/localId" }
+      }
