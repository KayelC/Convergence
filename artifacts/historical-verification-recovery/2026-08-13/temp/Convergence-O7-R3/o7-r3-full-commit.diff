+        "baseValue": { "type": "number", "minimum": 0 },
+        "usage": {
+          "type": "object", "additionalProperties": false,
+          "required": ["contexts", "consumeOn", "targeting", "effects"],
+          "properties": {
+            "contexts": { "type": "array", "minItems": 1, "items": { "$ref": "urn:convergence:schema:content:v9:shared#/$defs/contentId" } },
