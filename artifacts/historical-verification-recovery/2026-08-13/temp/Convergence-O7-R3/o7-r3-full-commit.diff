+          "additionalProperties": { "type": "integer" }
+        },
+        "elementalAffinities": {
+          "type": "object",
+          "propertyNames": { "$ref": "urn:convergence:schema:content:v9:shared#/$defs/damageElement" },
+          "additionalProperties": { "$ref": "urn:convergence:schema:content:v9:shared#/$defs/elementalAffinity" }
+        },
+        "ailmentResistances": {
+          "type": "object",
+          "propertyNames": { "$ref": "urn:convergence:schema:content:v9:shared#/$defs/localId" },
+          "additionalProperties": { "$ref": "urn:convergence:schema:content:v9:shared#/$defs/resistanceLevel" }
+        },
