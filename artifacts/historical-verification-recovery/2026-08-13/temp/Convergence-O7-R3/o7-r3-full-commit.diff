+            "required": ["level", "skillId"],
+            "properties": {
+              "level": { "type": "integer", "minimum": 1 },
+              "skillId": { "$ref": "urn:convergence:schema:content:v9:shared#/$defs/contentId" }
+            }
+          }
+        }
+      }
+    }
+  }
+}
