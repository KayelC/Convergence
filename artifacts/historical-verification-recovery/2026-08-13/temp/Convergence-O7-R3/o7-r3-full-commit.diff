+    "parent": {
+      "type": "object",
+      "additionalProperties": false,
+      "required": ["kind", "id", "role"],
+      "properties": {
+        "kind": { "enum": ["entity", "race"] },
+        "id": { "$ref": "urn:convergence:schema:content:v9:shared#/$defs/contentReference" },
+        "role": { "enum": ["participant", "catalyst", "rank_shift_target"] }
+      }
+    },
+    "result": {
+      "oneOf": [
+        {
+          "type": "object",
+          "additionalProperties": false,
+          "required": ["operation", "resultEntityId"],
+          "properties": {
+            "operation": { "const": "create_entity" },
+            "resultEntityId": { "$ref": "urn:convergence:schema:content:v9:shared#/$defs/contentReference" },
+            "parameters": { "$ref": "urn:convergence:schema:content:v9:shared#/$defs/parameters" }
+          }
+        },
+        {
+          "type": "object",
+          "additionalProperties": false,
+          "required": ["operation", "rankShift"],
+          "properties": {
+            "operation": { "const": "catalyst_rank_shift" },
+            "rankShift": { "type": "integer", "not": { "const": 0 } },
+            "parameters": { "$ref": "urn:convergence:schema:content:v9:shared#/$defs/parameters" }
+          }
+        },
+        {
+          "type": "object",
+          "additionalProperties": false,
+          "required": ["operation", "policyId"],
+          "properties": {
+            "operation": { "const": "stat_boost" },
+            "policyId": { "$ref": "urn:convergence:schema:content:v9:shared#/$defs/localId" },
+            "parameters": { "$ref": "urn:convergence:schema:content:v9:shared#/$defs/parameters" }
+          }
+        },
+        {
+          "type": "object",
+          "additionalProperties": false,
+          "required": ["operation", "policyId"],
+          "properties": {
+            "operation": { "const": "special" },
+            "policyId": { "$ref": "urn:convergence:schema:content:v9:shared#/$defs/localId" },
+            "parameters": { "$ref": "urn:convergence:schema:content:v9:shared#/$defs/parameters" }
+          }
+        }
+      ]
+    }
+  }
+}
