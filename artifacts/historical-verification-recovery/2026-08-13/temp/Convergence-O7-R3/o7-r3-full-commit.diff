+              "required": ["baseChance", "statId", "statMultiplier"],
+              "properties": {
+                "baseChance": { "type": "integer", "minimum": 0, "maximum": 100 },
+                "statId": { "$ref": "urn:convergence:schema:content:v9:shared#/$defs/contentId" },
+                "statMultiplier": { "type": "number" }
+              }
+            },
+            "removeOnEvents": { "type": "array", "items": { "$ref": "urn:convergence:schema:content:v9:shared#/$defs/contentId" } }
+          }
+        }
+      }
+    }
+  }
+}
