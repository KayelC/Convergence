<Project Sdk="Godot.NET.Sdk/4.7.1">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>12.0</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <AssemblyName>Convergence.GodotHost</AssemblyName>
    <RootNamespace>Convergence.GodotHost</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Convergence.Framework\Convergence.Framework.csproj" />
  </ItemGroup>

  <ItemGroup>
    <TrainingAnnexContent Include="..\..\content\original\training-annex\*.json" />
  </ItemGroup>

  <Target Name="PrepareGodotContent" BeforeTargets="BeforeBuild">
    <MakeDir Directories="$(MSBuildProjectDirectory)\Content\training-annex" />
    <Copy
      SourceFiles="@(TrainingAnnexContent)"
      DestinationFolder="$(MSBuildProjectDirectory)\Content\training-annex"
      SkipUnchangedFiles="true" />
  </Target>

</Project>
