{
  "$schema": "urn:convergence:schema:content:v10:rulesets",
  "schemaVersion": 10,
  "rulesets": [
    {
      "id": "standard_damage_sample",
      "displayName": "Standard Damage Policy",
      "description": "Names the host-owned standard damage policy.",
      "category": "damage",
      "policyId": "standard_damage",
      "parameters": {
        "weakDamageMultiplier": 1.5,
        "resistDamageMultiplier": 0.5
      }
    },
    {
      "id": "standard_reward_sample",
      "displayName": "Standard Reward Policy",
      "description": "Names the host-owned reward policy.",
      "category": "reward",
      "policyId": "standard_reward"
    },
    {
      "id": "standard_growth_sample",
      "displayName": "Standard Growth Policy",
      "description": "Names the host-owned growth policy.",
      "category": "growth",
      "policyId": "standard_growth"
    },
    {
      "id": "standard_stat_sample",
      "displayName": "Standard Stat Policy",
      "description": "Names the host-owned stat policy.",
      "category": "stat",
      "policyId": "standard_stat"
    },
    {
      "id": "persistent_staged_modifiers_sample",
      "displayName": "Persistent Staged Modifiers",
      "description": "Keeps bounded stat stages until explicit cleanup.",
      "category": "stat_modifier",
      "policyId": "persistent_staged",
      "parameters": {
        "minimumStage": -4,
        "maximumStage": 4
      }
    },
    {
      "id": "timed_exclusive_modifiers_sample",
      "displayName": "Timed Exclusive Modifiers",
      "description": "Keeps one timed weak or strong signal per modifier track.",
      "category": "stat_modifier",
      "policyId": "timed_exclusive"
    },
    {
      "id": "timed_contribution_modifiers_sample",
      "displayName": "Timed Contribution Modifiers",
      "description": "Keeps independently expiring signed contributions.",
      "category": "stat_modifier",
      "policyId": "timed_contribution",
      "parameters": {
        "minimumStage": -4,
        "maximumStage": 4
      }
    },
    {
      "id": "standard_action_token_sample",
      "displayName": "Standard Action Token Policy",
      "description": "Selects the Framework-supplied Action Token policy through host composition.",
      "category": "turn_economy",
      "policyId": "standard_action_token",
      "parameters": {
        "maximumCommands": 256,
        "maximumConsecutiveFreeActions": 32
      }
    },
    {
      "id": "standard_roster_capacity_sample",
      "displayName": "Standard Roster Capacity Policy",
      "description": "Defines an authored tiered roster-capacity policy.",
      "category": "roster_capacity",
      "policyId": "standard_roster_capacity",
      "parameters": {
        "tiers": [
          { "rosterKind": "hosted_entity", "minimumLevel": 1, "capacity": 3 },
          { "rosterKind": "hosted_entity", "minimumLevel": 10, "capacity": 5 },
          { "rosterKind": "hosted_entity", "minimumLevel": 20, "capacity": 7 },
          { "rosterKind": "hosted_entity", "minimumLevel": 30, "capacity": 10 },
          { "rosterKind": "hosted_entity", "minimumLevel": 40, "capacity": 12 },
          { "rosterKind": "companion", "minimumLevel": 1, "capacity": 3 },
          { "rosterKind": "companion", "minimumLevel": 10, "capacity": 5 },
          { "rosterKind": "companion", "minimumLevel": 20, "capacity": 7 },
          { "rosterKind": "companion", "minimumLevel": 30, "capacity": 10 },
          { "rosterKind": "companion", "minimumLevel": 40, "capacity": 12 }
        ]
      }
    },
    {
      "id": "standard_economy_sample",
      "displayName": "Standard Economy Policy",
      "description": "Names the host-owned economy policy.",
      "category": "economy",
      "policyId": "standard_economy",
      "parameters": {
        "pricingPolicyId": "standard_shop_pricing",
        "pricingParameters": {
          "resalePercentage": 0.5
        }
      }
