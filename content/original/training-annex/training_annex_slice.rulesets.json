{
  "$schema": "urn:convergence:schema:content:v8:rulesets",
  "schemaVersion": 8,
  "rulesets": [
    {
      "id": "standard_damage",
      "displayName": "Training Annex Damage",
      "description": "Binds the slice to the standard damage policy.",
      "category": "damage",
      "policyId": "standard_damage",
      "parameters": {
        "weakDamageMultiplier": 1.5,
        "resistDamageMultiplier": 0.5
      }
    },
    {
      "id": "standard_reward",
      "displayName": "Training Annex Rewards",
      "description": "Binds the slice to the standard reward policy.",
      "category": "reward",
      "policyId": "standard_reward"
    },
    {
      "id": "standard_growth",
      "displayName": "Training Annex Growth",
      "description": "Binds the slice to the standard growth policy.",
      "category": "growth",
      "policyId": "standard_growth"
    },
    {
      "id": "standard_stat",
      "displayName": "Training Annex Stats",
      "description": "Binds the slice to the standard stat policy.",
      "category": "stat",
      "policyId": "standard_stat"
    },
    {
      "id": "standard_stat_modifiers",
      "displayName": "Training Annex Persistent Stat Modifiers",
      "description": "Keeps bounded stat stages until explicit cleanup.",
      "category": "stat_modifier",
      "policyId": "persistent_staged",
      "parameters": {
        "minimumStage": -4,
        "maximumStage": 4
      }
    },
    {
      "id": "standard_action_token",
      "displayName": "Training Annex Action Tokens",
      "description": "Binds the slice to the standard Action Token policy.",
      "category": "turn_economy",
      "policyId": "standard_action_token",
      "parameters": {
        "maximumCommands": 256,
        "maximumConsecutiveFreeActions": 32
      }
    },
    {
      "id": "standard_roster_capacity",
      "displayName": "Training Annex Roster Capacity",
      "description": "Defines the slice's tiered roster-capacity policy.",
      "category": "roster_capacity",
      "policyId": "standard_roster_capacity",
      "parameters": {
        "tiers": [
          { "rosterKind": "hosted_entity", "minimumLevel": 1, "capacity": 3 },
          { "rosterKind": "hosted_entity", "minimumLevel": 10, "capacity": 5 },
          { "rosterKind": "hosted_entity", "minimumLevel": 20, "capacity": 7 },
          { "rosterKind": "hosted_entity", "minimumLevel": 30, "capacity": 10 },
          { "rosterKind": "hosted_entity", "minimumLevel": 40, "capacity": 12 },
          { "rosterKind": "companion", "minimumLevel": 1, "capacity": 3 },
          { "rosterKind": "companion", "minimumLevel": 10, "capacity": 5 },
          { "rosterKind": "companion", "minimumLevel": 20, "capacity": 7 },
          { "rosterKind": "companion", "minimumLevel": 30, "capacity": 10 },
          { "rosterKind": "companion", "minimumLevel": 40, "capacity": 12 }
        ]
      }
    },
    {
      "id": "standard_economy",
      "displayName": "Training Annex Economy",
      "description": "Binds the slice to the standard economy policy.",
      "category": "economy",
      "policyId": "standard_economy"
    }
  ]
}
