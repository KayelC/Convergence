{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:convergence:schema:content:v8:manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "id", "version", "displayName", "documents"],
  "properties": {
    "$schema": { "const": "urn:convergence:schema:content:v8:manifest" },
    "schemaVersion": { "const": 8 },
    "id": { "$ref": "urn:convergence:schema:content:v8:shared#/$defs/packId" },
    "version": { "$ref": "urn:convergence:schema:content:v8:shared#/$defs/semanticVersion" },
    "displayName": { "$ref": "urn:convergence:schema:content:v8:shared#/$defs/nonEmptyString" },
    "description": { "type": "string" },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "version"],
        "properties": {
          "id": { "$ref": "urn:convergence:schema:content:v8:shared#/$defs/packId" },
          "version": { "$ref": "urn:convergence:schema:content:v8:shared#/$defs/semanticVersion" }
        }
      }
    },
    "documents": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["type", "path"],
        "properties": {
          "type": { "enum": ["skills", "entities", "races", "ailments", "items", "equipment", "shops", "negotiations", "encounters", "dungeons", "fusion", "rulesets"] },
          "path": { "$ref": "urn:convergence:schema:content:v8:shared#/$defs/documentPath" }
        }
      }
    }
  }
}
