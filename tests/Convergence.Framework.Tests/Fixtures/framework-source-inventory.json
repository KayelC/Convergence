        "Convergence.Battle"
      ]
    },
    {
      "id": "catalog",
      "pathPrefix": "Catalog/",
      "responsibility": "Qualified content loading, catalog construction, repositories, and definition qualification.",
      "namespacePrefixes": [
        "Convergence.Catalog"
      ]
    },
    {
      "id": "content_contracts",
      "pathPrefix": "Content/",
      "responsibility": "Immutable authored definitions, IDs, vocabulary, conditions, effects, and deserialization contracts.",
      "namespacePrefixes": [
        "Convergence.Content"
      ]
    },
    {
      "id": "encounter_runtime",
      "pathPrefix": "Encounters/",
      "responsibility": "Actor creation, encounter orchestration, lifecycle ports, negotiation, rewards, and ordered events.",
      "namespacePrefixes": [
        "Convergence.Encounters"
      ]
    },
    {
      "id": "effect_execution",
      "pathPrefix": "Execution/",
      "responsibility": "Runtime actor state, targeting, assessment, effects, skills, items, passives, actions, and lifecycle execution.",
      "namespacePrefixes": [
        "Convergence.Execution"
      ]
    },
    {
      "id": "fusion_compendium",
      "pathPrefix": "Fusion/",
      "responsibility": "Fusion planning and transactions, strategy policies, Compendium integrity, recall, and pricing.",
      "namespacePrefixes": [
        "Convergence.Fusion"
      ]
    },
    {
      "id": "host_boundaries",
      "pathPrefix": "Hosting/",
      "responsibility": "Engine-neutral content, command, event, and randomness ports.",
      "namespacePrefixes": [
        "Convergence.Hosting"
      ]
    },
    {
      "id": "inheritance",
      "pathPrefix": "Inheritance/",
      "responsibility": "Typed fusion inheritance eligibility, planning, and selection validation.",
      "namespacePrefixes": [
        "Convergence.Inheritance"
      ]
    },
    {
      "id": "internal_shared",
      "pathPrefix": "Internal/",
      "responsibility": "Non-exported shared implementation guards.",
      "namespacePrefixes": [
        "Convergence.Internal"
      ]
    },
    {
      "id": "combat_knowledge",
      "pathPrefix": "Knowledge/",
      "responsibility": "Elemental, ailment, and instant-death battle knowledge stores.",
      "namespacePrefixes": [
        "Convergence.Knowledge"
      ]
    },
    {
      "id": "assembly_metadata",
      "pathPrefix": "Properties/",
      "responsibility": "Assembly-level metadata and test visibility.",
      "namespacePrefixes": []
    },
    {
      "id": "runtime_services",
      "pathPrefix": "Runtime/",
      "responsibility": "Progression, rosters, resources, navigation, traversal, persistence, restoration, and ruleset binding.",
      "namespacePrefixes": [
        "Convergence.Runtime"
      ]
    },
    {
      "id": "internal_serialization",
      "pathPrefix": "Serialization/",
      "responsibility": "Non-exported System.Text.Json DTOs, converters, source metadata, and mapping.",
      "namespacePrefixes": [
        "Convergence.Serialization"
      ]
    },
    {
      "id": "turn_economy",
      "pathPrefix": "TurnEconomy/",
      "responsibility": "Generic turn-economy contracts and the optional Action Token implementation.",
      "namespacePrefixes": [
        "Convergence.Execution",
        "Convergence.TurnEconomy"
      ]
    },
    {
      "id": "content_validation",
      "pathPrefix": "Validation/",
      "responsibility": "Semantic content validation, diagnostics, and registration snapshots.",
      "namespacePrefixes": [
        "Convergence.Validation"
      ]
    }
  ],
